# Copy to .env and fill in. Everything above the first blank-line group is
# required: the app refuses to start without it.

DATABASE_URL=postgresql://localhost:5432/app_dashboard

# Versioned organization/app catalog. Each organization in this file names its
# own token environment variable; the five variables below match the bundled
# Newcraft catalog. Never put token values in the YAML file.
APPS_CONFIG_PATH=config/apps.yml
SHOPIFY_PARTNER_TOKEN_3508770=
SHOPIFY_PARTNER_TOKEN_4626496=
SHOPIFY_PARTNER_TOKEN_4653231=
SHOPIFY_PARTNER_TOKEN_4742901=
SHOPIFY_PARTNER_TOKEN_4821379=

# One shared dashboard login. There is no signup or user management.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Where this dashboard is reachable. Used for links and origin checks.
PUBLIC_BASE_URL=http://localhost:8000

# Signs the session cookie. GENERATE ONE, do not use a memorable string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This repository is public, so any placeholder committed here is known to
# everyone: a deployment running on one forges any session with no credential.
# The app refuses to start on a non-localhost PUBLIC_BASE_URL with fewer than
# 32 characters here. Rotating it signs everyone out, which is also how you
# revoke every session at once.
SESSION_SECRET=


# Annual prices, listing URLs, usage event contracts/tokens, and GA4 properties
# are configured per app in APPS_CONFIG_PATH. A usage or GA4 secret is still an
# environment variable; the catalog stores only its variable name.

# Earliest GA4 backfill date shared by configured properties.
GA4_EARLIEST_DATA=2020-01-01

# --- Slack (optional) -------------------------------------------------------
# Stale-sync alerts and the weekly digest. Unset means neither is sent.
SLACK_WEBHOOK_URL=

# --- operational ------------------------------------------------------------
POLL_INTERVAL_MINUTES=15
POLL_OVERLAP_MINUTES=60

# Weekly digest schedule.
DIGEST_DAY_OF_WEEK=mon
DIGEST_HOUR=9
DIGEST_TIMEZONE=UTC

# The header your proxy puts the real client address in. Rate limiting keys on
# it, so a wrong value collapses every caller into one bucket.
#
# Prefer a single-value header your proxy OVERWRITES: Fly-Client-IP,
# CF-Connecting-IP, X-Real-IP. X-Forwarded-For also works, but it is a list
# that proxies append to, so the leftmost entry is whatever the client sent;
# only the rightmost is trustworthy, and that is the one read here.
#
# Leave empty when nothing sits in front of the app.
TRUSTED_CLIENT_IP_HEADER=

# No chart annotation may be dated before this. Set it to roughly when your app
# launched.
ANNOTATIONS_EARLIEST=2020-01-01

# Shopify made the uninstall-reason question mandatory during 2026. Coverage
# either side is not comparable, so reports split on this date. Verify it
# against your own feed: it is the day after your last empty uninstall reason.
REASON_MANDATORY_FROM=2026-04-29

# Persistent archive for icons and screenshots from followed public apps.
# Must be absolute and must be a durable mount in production.
WATCHLIST_MEDIA_PATH=/data/mantle-watchlist
# Daily listing downloads run in parallel, bounded to 1-4 workers.
WATCHLIST_CONCURRENCY=2
# Store-wide public review collection rotates through this many apps hourly.
REVIEW_APP_BATCH_SIZE=250
# Historical pages advanced per selected app and run; keep this deliberately low.
REVIEW_BACKFILL_PAGES_PER_RUN=1
ICON_APP_BATCH_SIZE=500

# --- private research attachments (optional) -------------------------------
# A dedicated private Backblaze B2 bucket exposed through its S3-compatible
# endpoint. When unset, notes still work but file uploads are unavailable.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=eu-central-003
B2_BUCKET=
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Accepted screenshots and documents are capped at 15 MiB by default.
RESEARCH_UPLOAD_MAX_BYTES=15728640

# Not a Settings field, read straight from the environment: set to 1 to skip
# starting the background scheduler. The test suite sets it.
NO_SCHEDULER=
